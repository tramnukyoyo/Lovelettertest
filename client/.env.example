# Backend Server URL (for local development)
# Leave empty in production - it will automatically use the same origin (GameBuddies reverse proxy)
VITE_BACKEND_URL=http://localhost:3001

# Base Path Configuration
# - Standalone Render deployment: Leave empty (defaults to '/')
# - GameBuddies reverse proxy: Set to '/heartsgambit/'
# VITE_BASE_PATH=/heartsgambit/

# Development Note:
# - Local dev: Set VITE_BACKEND_URL to http://localhost:3001
# - Production: Leave empty or unset - the app will use window.location.origin
# - This ensures compatibility with GameBuddies reverse proxy

# GameBuddies Integration
# NOTE: API key is NOT needed in client - server handles GameBuddies API calls
# The server has access to the API key via process.env.GAMEBUDDIES_API_KEY
# This keeps the API key secure and not exposed to the browser

# WebRTC TURN Server (optional - for mobile cellular support)
VITE_METERED_USERNAME=your_metered_username
VITE_METERED_PASSWORD=your_metered_password